{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "client_message_id",
    "attachments"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "client_message_id": {
      "type": "string",
      "format": "uuid"
    },
    "attachments": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "asset_id"
        ],
        "properties": {
          "type": {
            "const": "image"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
